{
  "name": "@hecate/mcp",
  "version": "1.1.7",
  "private": true,
  "type": "module",
  "description": "Hecate MCP server — thin proxy to Rust internal API",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
